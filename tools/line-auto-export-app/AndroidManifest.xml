<?xml version="1.0" encoding="utf-8"?>
<!--
  SA LINE Export - 最小アプリ（段階1）
  正本: docs/handoff/line-auto-export-app/design.md
  この段階では PIN 保存・ロック解除実測・起動口のみ。LINE操作は未実装。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="jp.salesanchor.lineexport"
    android:versionCode="1"
    android:versionName="0.1.0-stage1">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="24" />

    <!-- 画面ウェイク（PowerManager.WakeLock）に必要。dangerous permission ではないためインストール時に自動付与される。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- 設定Activity: PINを一度だけ入力して保存する。保存済みかどうかだけを表示。 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AccessibilityService: ロック解除操作の実行主体。 -->
        <service
            android:name=".UnlockAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 起動口: Termuxから `am broadcast -a jp.salesanchor.lineexport.RUN` で実行合図。PINはextraに載せない。 -->
        <receiver
            android:name=".RunReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="jp.salesanchor.lineexport.RUN" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
