-- ==== 2. is_current rows per (channel, condition) among pid_resolved rows of the three survivors ====
BEGIN READ ONLY; SELECT product_id, count(*) AS partitions, count(*) FILTER (WHERE cur = 0) AS partitions_with_0_current, count(*) FILTER (WHERE cur = 1) AS partitions_with_1_current, count(*) FILTER (WHERE cur NOT BETWEEN 0 AND 1) AS partitions_with_more_than_1_current, max(cur) AS max_current_in_a_partition FROM (SELECT ar.product_id, sm.supplier_channel_id AS channel, ar.condition_id, count(*) FILTER (WHERE ar.is_current IS TRUE) AS cur FROM public.analysis_results ar JOIN public.extraction_items ei ON ei.id = ar.extraction_item_id JOIN public.extraction_jobs ej ON ej.id = ei.extraction_job_id JOIN public.source_messages sm ON sm.id = ej.source_message_id WHERE ar.product_id IN (226, 625, 626) AND ar.pid_resolved = TRUE GROUP BY 1, 2, 3) q GROUP BY product_id ORDER BY product_id; (second query: the partitions with more than 1 current row) ROLLBACK;
BEGIN
 product_id | partitions | partitions_with_0_current | partitions_with_1_current | partitions_with_more_than_1_current | max_current_in_a_partition
------------+------------+---------------------------+---------------------------+-------------------------------------+----------------------------
        226 |         26 |                         0 |                        26 |                                   0 |                          1
        625 |         15 |                         0 |                        15 |                                   0 |                          1
        626 |         12 |                         0 |                        12 |                                   0 |                          1
