-- query (read-only, run after apply on 2026-10-04 ~23:12Z via: docker compose exec -T postgres psql -X -c '<SQL>')
BEGIN READ ONLY; SELECT p.id, p.product_code, p.mark, p.name, p.is_active, (SELECT string_agg(k.position::text || chr(58) || k.keyword, chr(32) || chr(124) || chr(32) ORDER BY k.position, k.id) FROM public.product_search_keywords k WHERE k.product_id = p.id) AS search_keywords, (SELECT string_agg(k.position::text || chr(58) || k.keyword, chr(32) || chr(124) || chr(32) ORDER BY k.position, k.id) FROM public.product_exclude_keywords k WHERE k.product_id = p.id) AS exclude_keywords, p.updated_at FROM public.products p WHERE p.id IN (58, 60, 74, 75, 103, 105) ORDER BY p.id; ROLLBACK;
